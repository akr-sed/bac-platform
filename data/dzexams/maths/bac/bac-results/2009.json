      "title": "الموضوع الأول - التمرين 1",
      "statement": "$x$ عدد طبيعي أكبر من 1 و $y$ عدد طبيعي.\n$A$ عدد طبيعي يكتب في نظام التعداد ذي الأساس $x$ بالشكل $A = \\overline{5566}$.",
      "topic": "arithmetique",
      "concepts": [
        "divisibilite",
        "nombres_premiers",
        "decomposition_facteurs_premiers"
      ],
      "difficulty": "medium",
      "marks": 4.0,
      "has_figure": false,
      "source_page": 1,
      "solution": null,
