          "statement": "حدد طبيعة المثلث $ABC$.",
          "marks": null,
          "depends_on": [
            "2-أ"
          ],
          "solution": "المثلث $ABC$ متقايس الأضلاع لأن $AB=AC$ والزاوية بينهما $60^\\circ$.",
          "ordering": 3,
          "metadata": {}
        },
        {
          "id": "d4e5f6a7-b8c9-4012-1234-567890abcdef",
