          "label": "1",
          "sub_label": "ب",
          "statement": "بيّن أن المتتالية $(u_n)$ متزايدة تماما ثم استنتج أنها متقاربة.",
          "marks": 0.75,
          "depends_on": [
            "1-a"
          ],
          "solution": "$u_{n+1}^2 - u_n^2 = 2 - \\frac{1}{2}u_n^2 = \\frac{1}{2}(4-u_n^2) > 0$.",
          "ordering": 2,
          "metadata": {}
        },
        {
